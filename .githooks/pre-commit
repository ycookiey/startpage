#!/bin/sh

# Pre-commit checks for version consistency.
# Version bump is required once per branch (compared against upstream/main),
# not per commit — a single PR bumps version.json once regardless of how
# many commits touch index.html or sw.js.
# Reports all issues at once so fixes can be made in a single pass.

staged=$(git diff --cached --name-only)

has_app=false
has_bump=false
has_sw=false

for f in $staged; do
    case "$f" in
        index.html) has_app=true ;;
        sw.js) has_app=true; has_sw=true ;;
        yfuzzy.min.js) has_app=true ;;
        version.json) has_bump=true ;;
    esac
done

get() { git show :"$1" 2>/dev/null || git show HEAD:"$1" 2>/dev/null; }
extract_ver() { sed -n 's/.*"version".*"\([^"]*\)".*/\1/p'; }
ver_json=$(get version.json | extract_ver)
ver_sw=$(get sw.js | sed -n 's/^const VERSION = \([0-9]*\);.*/\1/p')

# Baseline version to compare against — a branch is "already bumped" if the
# current version differs from this baseline, regardless of which commit did it.
base_ref=$(git rev-parse --verify --quiet '@{upstream}' \
        || git rev-parse --verify --quiet origin/main \
        || git rev-parse --verify --quiet main)
base_ver=""
if [ -n "$base_ref" ]; then
    base_ver=$(git show "$base_ref:version.json" 2>/dev/null | extract_ver)
fi

errors=0

# yfuzzy.min.js is a generated asset referenced by index.html and sw.js;
# a commit that leaves it untracked ships a page whose search cannot load.
if ! git ls-files --error-unmatch yfuzzy.min.js >/dev/null 2>&1; then
    echo "⚠ yfuzzy.min.js is not tracked (index.html and sw.js reference it)"
    echo "  Run: git add yfuzzy.min.js"
    errors=1
fi

if [ "$has_app" = true ] && [ "$has_bump" = false ] && [ -n "$base_ver" ] && [ "$ver_json" = "$base_ver" ]; then
    next=$((ver_json + 1))
    echo "⚠ index.html or sw.js changed without bumping version.json on this branch"
    echo "  Run: echo '{\"version\":\"$next\"}' > version.json"
    if [ "$has_sw" = false ] || [ "$ver_sw" != "$next" ]; then
        echo "  Also update sw.js: const VERSION = $next;"
    fi
    errors=1
fi

if [ "$has_bump" = true ] && [ -n "$ver_json" ] && [ -n "$ver_sw" ] && [ "$ver_json" != "$ver_sw" ]; then
    echo "⚠ sw.js VERSION ($ver_sw) does not match version.json ($ver_json)"
    echo "  Update sw.js: const VERSION = $ver_json;"
    errors=1
fi

if [ "$errors" = 1 ]; then
    echo "  To skip: git commit --no-verify"
    exit 1
fi

exit 0
